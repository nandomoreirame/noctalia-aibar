{
  "id": "aibar",
  "name": "AI Bar",
  "version": "0.1.1",
  "minNoctaliaVersion": "4.6.0",
  "author": "Fernando Moreira Costa",
  "license": "MIT",
  "repository": "https://github.com/nandomoreirame/noctalia-aibar",
  "description": "Claude Code and Grok plan usage in the bar: percent, reset countdown and a progress bar.",
  "tags": ["Bar", "Panel", "AI", "Development"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": { "plugins": [] },
  "metadata": {
    "defaultSettings": {
      "barProvider": "claude",
      "pollMinutes": 5,
      "notifyThreshold": 97,
      "claudeUserAgent": "claude-cli/2.1.281 (external, cli)"
    }
  }
}
