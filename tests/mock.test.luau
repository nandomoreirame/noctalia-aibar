local assert = require("./support/assert")
local runner = require("./support/runner")
local mock = require("./support/noctalia_mock")

local describe, it = runner.describe, runner.it

describe("mock extensions", function()
	it("defers http callbacks until respond", function()
		local env = mock.new({})
		local got = nil
		env.noctalia.http({ url = "https://x.test" }, function(res)
			got = res
		end)
		assert.equal(got, nil)
		assert.equal(#mock.pendingHttp(env), 1)
		mock.respond(env, 1, { ok = true, status = 200, body = "{}" })
		assert.equal(got.status, 200)
	end)

	it("controls now, file info, config and orientation", function()
		local env = mock.new({ now = 5, fs = { ["~/a"] = "x" }, config = { k = 1 } })
		assert.equal(env.noctalia.nowMs(), 5)
		mock.setNow(env, 9)
		assert.equal(env.noctalia.nowMs(), 9)
		assert.equal(env.noctalia.fileInfo("~/a").mtime, 1)
		mock.setFile(env, "~/a", "yy", 7)
		assert.equal(env.noctalia.readFile("~/a"), "yy")
		assert.equal(env.noctalia.fileInfo("~/a").mtime, 7)
		assert.equal(env.noctalia.fileInfo("~/missing"), nil)
		mock.setConfig(env, "k", 2)
		assert.equal(env.noctalia.getConfig("k"), 2)
		assert.equal(env.barWidget.isVertical(), false)
		mock.setVertical(env, true)
		assert.equal(env.barWidget.isVertical(), true)
	end)

	it("translates to the key plus sorted substitutions", function()
		local env = mock.new({})
		assert.equal(env.noctalia.tr("a.b"), "a.b")
		assert.equal(env.noctalia.tr("a.b", { t = "1h", n = 3 }), "a.b n=3 t=1h")
		assert.equal(mock.fakeTr("x", { n = 1 }), "x n=1")
	end)

	it("builds ui nodes with type, props and children", function()
		local env = mock.new({})
		local node = env.ui.row({ gap = 4 }, { env.ui.glyph({ name = "asterisk" }), env.ui.progress({ progress = 0.5 }) })
		assert.equal(node.type, "row")
		assert.equal(node.props.gap, 4)
		assert.equal(node.children[1].type, "glyph")
		assert.equal(node.children[2].props.progress, 0.5)
	end)

	it("exposes the JSON codec", function()
		local data = mock.json.decode('{"a":[1,2],"b":null}')
		assert.equal(data.a[2], 2)
		assert.equal(data.b, nil)
	end)
end)
