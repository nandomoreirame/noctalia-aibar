local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")

local describe, it = runner.describe, runner.it
local poll = modules.load("lib/poll.luau")
local SNAP = { provider = "claude", windows = { { id = "session", percent = 1 } } }

describe("poll", function()
	it("allows one request at a time", function()
		local s = poll.begin(poll.createState(), 0)
		assert.equal(poll.canRequest(s, 0), false)
		assert.equal(poll.canRequest(poll.succeed(s, SNAP), 0), true)
	end)

	it("keeps the last snapshot as stale on failure", function()
		local ok = poll.succeed(poll.begin(poll.createState(), 0), SNAP)
		local bad = poll.fail(poll.begin(ok, 1), "network", 0, 1)
		assert.equal(bad.snapshot, SNAP)
		assert.equal(bad.stale, true)
		assert.equal(bad.error, "network")
		assert.equal(bad.inFlight, false)
	end)

	it("maps HTTP status codes to error kinds", function()
		assert.equal(poll.fail(poll.createState(), "http", 401, 0).error, "auth")
		assert.equal(poll.fail(poll.createState(), "http", 403, 0).error, "auth")
		local s = poll.fail(poll.createState(), "http", 500, 0)
		assert.equal(s.error, "http")
		assert.equal(s.code, 500)
	end)

	it("backs off for five minutes after a 429", function()
		local s = poll.fail(poll.createState(), "http", 429, 1000)
		assert.equal(s.error, "rate-limited")
		assert.equal(poll.canRequest(s, 1000 + poll.BACKOFF_MS - 1), false)
		assert.equal(poll.canRequest(s, 1000 + poll.BACKOFF_MS), true)
	end)

	it("clears the error and backoff on success", function()
		local s = poll.succeed(poll.begin(poll.fail(poll.createState(), "http", 429, 0), poll.BACKOFF_MS), SNAP)
		assert.equal(s.error, "")
		assert.equal(s.stale, false)
		assert.equal(s.retryAt, 0)
		assert.equal(s.snapshot, SNAP)
	end)

	it("keeps credential errors and is not stale without a snapshot", function()
		local s = poll.fail(poll.createState(), "claude-expired", 0, 0)
		assert.equal(s.error, "claude-expired")
		assert.equal(s.stale, false)
	end)

	it("frees a request that never answers", function()
		local s = poll.begin(poll.createState(), 1000)
		assert.equal(poll.canRequest(s, 1000 + poll.REQUEST_TIMEOUT_MS - 1), false)
		assert.equal(poll.canRequest(s, 1000 + poll.REQUEST_TIMEOUT_MS), true)
	end)

	it("still honors the 429 backoff while freeing a hung request", function()
		local s = poll.begin(poll.fail(poll.createState(), "http", 429, 0), 0)
		assert.equal(poll.canRequest(s, poll.REQUEST_TIMEOUT_MS), false)
		assert.equal(poll.canRequest(s, poll.BACKOFF_MS), true)
	end)

	it("restores a cached snapshot as stale until the first answer", function()
		local s = poll.restore(poll.createState(), SNAP)
		assert.equal(s.snapshot, SNAP)
		assert.equal(s.stale, true)
		assert.equal(poll.canRequest(s, 0), true)
	end)

	it("never replaces live data with the cache, and ignores junk", function()
		local live = poll.succeed(poll.createState(), SNAP)
		assert.equal(poll.restore(live, { windows = {} }), live)
		assert.equal(poll.restore(poll.createState(), nil).snapshot, nil)
		assert.equal(poll.restore(poll.createState(), { windows = "x" }).snapshot, nil)
	end)
end)
